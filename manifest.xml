<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>e75fd239-f31c-47ec-a2c3-c41d0ba81944</Id>
  <Version>1.0.0.1</Version><ProviderName>LocalCorrect contributors</ProviderName><DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="LocalCorrect RC"/><Description DefaultValue="Local selected-text spelling correction output. Copy and paste manually. Outlook on the web RC."/>
  <IconUrl DefaultValue="https://mrksrus.github.io/localcorrect-outlook/assets/icon-64.png"/><HighResolutionIconUrl DefaultValue="https://mrksrus.github.io/localcorrect-outlook/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://mrksrus.github.io/localcorrect-outlook/support.html"/>
  <Hosts><Host Name="Mailbox"/></Hosts><Requirements><Sets><Set Name="Mailbox" MinVersion="1.10"/></Sets></Requirements>
  <FormSettings><Form xsi:type="ItemEdit"><DesktopSettings><SourceLocation DefaultValue="https://mrksrus.github.io/localcorrect-outlook/taskpane.html"/></DesktopSettings></Form></FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.10"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <FunctionFile resid="Taskpane.Url"/>
      <ExtensionPoint xsi:type="MessageComposeCommandSurface"><OfficeTab id="TabDefault"><Group id="LocalCorrect.Group">
        <Label resid="Group.Label"/><Control xsi:type="Button" id="LocalCorrect.Open"><Label resid="Button.Label"/>
          <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources><bt:Images>
      <bt:Image id="Icon.16" DefaultValue="https://mrksrus.github.io/localcorrect-outlook/assets/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://mrksrus.github.io/localcorrect-outlook/assets/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://mrksrus.github.io/localcorrect-outlook/assets/icon-80.png"/>
    </bt:Images><bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="https://mrksrus.github.io/localcorrect-outlook/taskpane.html"/></bt:Urls>
    <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="LocalCorrect"/><bt:String id="Button.Label" DefaultValue="LocalCorrect RC"/></bt:ShortStrings>
    <bt:LongStrings><bt:String id="Button.Description" DefaultValue="Open local selected-text spelling correction. New HTML messages, Outlook on the web only."/></bt:LongStrings></Resources>
  </VersionOverrides>
</OfficeApp>
